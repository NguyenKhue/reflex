# Copy to .env (gitignored) and fill in. Shell environment variables win over this file.
# Only plans that log in need an account; the bundled Settings example needs none.
REFLEX_TEST_PHONE=
REFLEX_TEST_PASSWORD=
REFLEX_TEST_PIN=
# Optional per-platform accounts (win over the shared ones above). Android and iOS running at the same
# time on ONE account log each other out, so give each platform its own test account.
REFLEX_TEST_PHONE_ANDROID=
REFLEX_TEST_PHONE_IOS=
# REFLEX_TEST_PASSWORD_ANDROID=
# Confidence the decider must reach before its choice is executed (0 < n <= 1; default 0.75)
JEV_CONFIDENCE_THRESHOLD=
# Needed only when a decider (Jev) is used
TYPESAFE_API_KEY=

# Where `uploadReport` posts a finished report (optional; no default in code)
REPORT_UPLOAD_URL=
